<% layout("/layouts/boilerplate") %>
<div class="row mt-4 mb-5">
    <div class="col-8 offset-2">
        <h2 class="fw-bold mb-3"><%= listing.title %></h2>
        
        <!-- Main Image Card -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 50vh; object-fit: cover;">
            
            <div class="card-body p-4 p-md-5">
                <p class="card-text text-muted mb-4">
                    <i>Hosted by <%= listing.owner.username %></i>
                </p>
                <p class="card-text fs-5 mb-4">
                    <%= listing.description %>
                </p>
                
                <hr class="text-muted">
                
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <div>
                        <h3 class="fw-bold mb-0">₹ <%= listing.price.toLocaleString("en-IN") %> <span class="fs-6 text-muted fw-normal">/ night</span></h3>
                    </div>
                    <div class="text-end">
                        <p class="mb-0 fw-semibold"><i class="fa-solid fa-location-dot text-danger me-1"></i> <%= listing.location %></p>
                        <p class="text-muted mb-0"><%= listing.country %></p>
                    </div>
                </div>

                <!-- Optional: Edit & Delete buttons (if user is owner) -->
                <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
                    <div class="d-flex gap-2 mt-4 pt-3">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark px-4 rounded-3 fw-semibold">Edit</a>
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                            <button class="btn btn-outline-danger px-4 rounded-3 fw-semibold">Delete</button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Reviews Section -->
        <div class="mt-5">
            <h4 class="fw-bold mb-4"><i class="fa-solid fa-star text-warning me-2"></i>Reviews</h4>
            <!-- Your existing review loop goes here -->
        </div>

        <hr class="my-5">

        <!-- Map Section -->
        <div class="mb-4">
            <h4 class="fw-bold mb-3">Where you'll be</h4>
            <div id="map" class="rounded-4 shadow-sm" style="height: 400px; width: 100%;"></div>
        </div>
    </div>
</div>
