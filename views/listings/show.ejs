<% layout("/layouts/boilerplate") %>
<script>
    const mapToken = "<%= mapToken %>";
    // @ts-ignore
    const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-4 mb-5">
    <div class="col-10 col-md-8 offset-md-2">
        <h2 class="fw-bold mb-3"><%= listing.title %></h2>
        
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 50vh; object-fit: cover;">
            
            <div class="card-body p-4 p-md-5">
                <p class="card-text text-muted mb-4">
                    <i>Hosted by <%= listing.owner ? listing.owner.username : "Unknown User" %></i>
                </p>
                <p class="card-text fs-5 mb-4">
                    <%= listing.description %>
                </p>
                
                <hr class="text-muted">
                
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <div>
                        <h3 class="fw-bold mb-0">&#8377; <%= listing.price.toLocaleString("en-IN") %> <span class="fs-6 text-muted fw-normal">/ night</span></h3>
                    </div>
                    <div class="text-end">
                        <p class="mb-0 fw-semibold"><i class="fa-solid fa-location-dot text-danger me-1"></i> <%= listing.location %></p>
                        <p class="text-muted mb-0"><%= listing.country %></p>
                    </div>
                </div>

                <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)){ %>
                    <div class="d-flex gap-2 mt-4 pt-3">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark px-4 rounded-3 fw-semibold">Edit</a>
                        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE" class="d-inline">
                            <button class="btn btn-outline-danger px-4 rounded-3 fw-semibold">Delete</button>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>

        <% if(currUser){ %>
            <hr class="my-5">
            <h4 class="fw-bold mb-4">Leave a review</h4>
            
            <div class="card border-0 shadow-sm rounded-4 mb-5 p-4">
                <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label for="rating" class="form-label fw-semibold">Rating</label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>

                    <div class="mb-3">
                        <label for="comment" class="form-label fw-semibold">Comments</label>
                        <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control rounded-3" required></textarea>
                        <div class="invalid-feedback">Please add some comments for review</div>
                    </div>
                    <button class="btn btn-dark px-4 rounded-3 fw-semibold">Submit</button>
                </form>
            </div>
        <% } %>

        <% if(listing.reviews.length > 0){ %>
            <hr class="my-5">
            <h4 class="fw-bold mb-4"><i class="fa-solid fa-star text-warning me-2"></i>All Reviews</h4>
            <div class="row">
                <% for(review of listing.reviews){ %>
                    <div class="col-md-6 mb-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                            <div class="card-body">
                                <h5 class="card-title fw-bold">@<%= review.author ? review.author.username : "Unknown User" %></h5>
                                <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>"></p>
                                <p class="card-text text-muted"><%= review.comment%></p>
                                
                                <form method="POST" action="/listings/<%=listing._id%>/reviews/<%= review._id%>?_method=DELETE" class="mt-3">
                                    <button class="btn btn-sm btn-outline-danger rounded-3">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
        
        <% if(listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length) { %>
            <hr class="my-5">
            <h4 class="fw-bold mb-3">Where you'll be</h4>
            <div id="map" class="rounded-4 shadow-sm mb-4" style="height: 400px; width: 100%;"></div>
        <% } %>
    </div>
</div>

<script src="/js/map.js"></script>
