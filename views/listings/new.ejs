<% layout("/layouts/boilerplate") %>
<div class="row mt-4 mb-5">
    <div class="col-8 offset-2">
        <h3 class="fw-bold mb-4">Create a New Listing</h3>
        
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                    
                    <div class="mb-4">
                        <label for="title" class="form-label fw-semibold">Title</label>
                        <input name="listing[title]" placeholder="Add a catchy title" type="text" class="form-control form-control-lg rounded-3" required>
                    </div>

                    <div class="mb-4">
                        <label for="description" class="form-label fw-semibold">Description</label>
                        <textarea name="listing[description]" class="form-control rounded-3" placeholder="Describe your place..." rows="4" required></textarea>
                    </div>

                    <div class="mb-4">
                        <label for="image" class="form-label fw-semibold">Upload Listing Image</label>
                        <input name="listing[image]" type="file" class="form-control rounded-3" required>
                    </div>

                    <div class="mb-4">
                        <label for="category" class="form-label fw-semibold">Category</label>
                        <select name="listing[category]" class="form-select rounded-3" required>
                            <option value="" disabled selected>Select a category</option>
                            <option value="Trending">Trending</option>
                            <option value="Rooms">Rooms</option>
                            <option value="Iconic cities">Iconic cities</option>
                            <option value="Surfing">Surfing</option>
                            <option value="Beach">Beach</option>
                            <option value="Cabins">Cabins</option>
                            <option value="Farms">Farms</option>
                            <option value="Amazing pools">Amazing pools</option>
                            <option value="Lakefront">Lakefront</option>
                            <option value="Castles">Castles</option>
                            <option value="Camping">Camping</option>
                            <option value="Boats">Boats</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="mb-4 col-md-4">
                            <label for="price" class="form-label fw-semibold">Price</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 fw-bold">₹</span>
                                <input name="listing[price]" placeholder="1200" type="number" class="form-control border-start-0 rounded-end-3" required>
                            </div>
                        </div>
                        
                        <div class="mb-4 col-md-8">
                            <label for="country" class="form-label fw-semibold">Country</label>
                            <input name="listing[country]" placeholder="India" type="text" class="form-control rounded-3" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="location" class="form-label fw-semibold">Location</label>
                        <input name="listing[location]" placeholder="Lucknow, Uttar Pradesh" type="text" class="form-control rounded-3" required>
                    </div>

                    <button class="btn btn-danger btn-lg w-100 rounded-3 mt-2 fw-bold" style="background-color: #ff385c; border: none;">Create Listing</button>
                </form>
            </div>
        </div>
    </div>
</div>
